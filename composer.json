{
    "name": "febis/simpletca",
    "description": "Provides shortcuts and utilities for simple TCA generation",
    "license": "proprietary",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "extension"
    ],
    "authors": [
        {
            "name": "Felix Biskoping",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "helhum/dotenv-connector": "^3.1",
        "typo3/minimal": "^13"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.44",
        "friendsoftypo3/phpstan-typo3": "^0.9",
        "overtrue/phplint": "^9.5",
        "phpmd/phpmd": "^2.15",
        "squizlabs/php_codesniffer": "^3.10",
        "ssch/typo3-rector": "^2.11"
    },
    "replace": {
        "typo3-ter/simpletca": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Febis\\SimpleTca\\": "Classes"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "helhum/dotenv-connector": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": "bin",
        "platform": {
            "php": "8.3"
        },
        "vendor-dir": "vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "simpletca"
        }
    },
    "scripts": {
        "lint:all": [
            "@lint:phpcs",
            "@lint:phpmd",
            "@lint:phplint"
        ],
        "lint:phpcs": [
            "bin/phpcs -s -p --standard=.testing/phpcs/ruleset.xml"
        ],
        "lint:phplint": [
            "bin/phplint -v --ansi --no-cache ./ --exclude vendor"
        ],
        "lint:phpmd": [
            "bin/phpmd ./ ansi .testing/phpmd/ruleset.xml"
        ],
        "test:all": [
            "@test:phpstan",
            "@test:rector:dry"
        ],
        "test:phpstan": [
            "php -d memory_limit=4G bin/phpstan analyse -c .testing/phpstan/phpstan.neon ./"
        ],
        "test:rector": [
            "bin/rector process --config=.testing/rector/rector.php ./"
        ],
        "test:rector:dry": [
            "bin/rector process --config=.testing/rector/rector.php --dry-run ./"
        ]
    }
}
