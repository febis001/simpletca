{
    "name": "febis/simpletca",
    "description": "Provides shortcuts and utilities for simple TCA generation",
    "license": "proprietary",
    "type": "typo3-cms-extension",
    "version": "14.0.0",
    "keywords": [
        "TYPO3",
        "extension"
    ],
    "authors": [
        {
            "name": "Felix Biskoping",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "helhum/dotenv-connector": "^3.1",
        "typo3/minimal": "^14"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.44",
        "overtrue/phplint": "^9.5",
        "phpmd/phpmd": "^2.15",
        "symplify/easy-coding-standard": "^12.5",
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^3.1",
        "ssch/typo3-rector": "^3.14"
    },
    "replace": {
        "typo3-ter/simpletca": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Febis\\SimpleTca\\": "Classes"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "helhum/dotenv-connector": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": "bin",
        "platform": {
            "php": "8.3"
        },
        "vendor-dir": "vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "simpletca"
        }
    },
    "scripts": {
        "lint:all": [
            "@lint:phpecs",
            "@lint:phpmd",
            "@lint:phplint",
            "@lint:phpstan",
            "@lint:rector"
        ],
        "lint:phpecs": [
            "bin/ecs check --config .testing/phpecs/ecs.php"
        ],
        "lint:phpecs:fix": [
            "bin/ecs check --fix --config .testing/phpecs/ecs.php"
        ],
        "lint:phplint": [
            "bin/phplint -v --ansi --no-cache ./ --exclude vendor"
        ],
        "lint:phpmd": [
            "bin/phpmd ./ ansi .testing/phpmd/ruleset.xml"
        ],
        "lint:phpstan": [
            "php -d memory_limit=4G bin/phpstan analyse -c .testing/phpstan/phpstan.neon ./"
        ],
        "lint:rector": [
            "bin/rector process --config=.testing/rector/rector.php ./"
        ],
        "lint:rector:dry": [
            "bin/rector process --config=.testing/rector/rector.php --dry-run ./"
        ]
    }
}
